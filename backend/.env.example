# PostgreSQL
PRODUCTION_POSTGRES_HOST=localhost
PRODUCTION_POSTGRES_USER=postgres
PRODUCTION_POSTGRES_PASSWORD=changeme
PRODUCTION_POSTGRES_DB=api_testing
PRODUCTION_POSTGRES_PORT=5432

# JWT
JWT_SECRET_KEY=your-jwt-secret-here
JWT_ALGORITHM=HS256

# Secrets vault (phase 1) — generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Must match across API process AND scheduler process
SECRET_ENC_KEY=

# Outbound HTTP — set to "false" only for local dev with self-signed certs
OUTBOUND_VERIFY_TLS=true

# CORS — comma-separated origins for prod; leave as * for dev
# Example: CORS_ORIGINS=https://app.example.com,https://admin.example.com
CORS_ORIGINS=*

# SSRF allowlist — comma-separated hostnames allowed even if they resolve to private IPs
# Default covers Docker-to-host routing
SSRF_ALLOWLIST=host.docker.internal,localhost,127.0.0.1
