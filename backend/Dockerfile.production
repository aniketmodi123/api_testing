# backend/docker/Dockerfile.production
ARG PYTHON_VERSION=python:3.10-slim
FROM ${PYTHON_VERSION}

ENV TZ=Asia/Kolkata \
    PYTHONUNBUFFERED=1

WORKDIR /app

# deps
COPY ./src/requirements.txt /app/requirements.txt
RUN python -m pip install --upgrade pip \
 && pip install --no-cache-dir -r requirements.txt

# app code — copy the DIRECTORY as /app/src
COPY ./src /app
# embedded MCP server package (imported by main.py as mcp_server.*)
COPY ./mcp_server /app/mcp_server
# case-generation prompt read at runtime by the MCP server
COPY ./gpt_test_case_creatio_prompt.txt /app/gpt_test_case_creatio_prompt.txt

# start
CMD uvicorn main:app --host 0.0.0.0 --port ${PORT:-8080}
