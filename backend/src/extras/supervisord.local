; supervisord.conf

[supervisord]
nodaemon=true

[program:uvicorn]
command=python -m debugpy --wait-for-client --listen 0.0.0.0:5000 -m uvicorn main:app --reload --reload-exclude extras --host 0.0.0.0 --log-config /app/extras/log_config.yaml
directory=/app
autostart=true
autorestart=true
redirect_stderr=true
stdout_logfile=/app/extras/main.log