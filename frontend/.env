# API Configuration
# Your backend server (running locally with Docker)
# VITE_API_BASE=http://localhost:7005
VITE_API_BASE=https://api-testing-2vjt.onrender.com/

# Ngrok tunnel for external APIs you want to test (not your backend)
# VITE_API_BASE=https://sharply-integral-sturgeon.ngrok-free.app

# Development environment
VITE_ENV=development

# Debug logging (set to 'true' to enable verbose logging in production)
VITE_ENABLE_DEBUG_LOGS=true
